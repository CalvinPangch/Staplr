{
  "name": "staplr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration --project contract",
    "test:docker": "node scripts/test-docker.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "sandbox:build": "node scripts/build-sandbox-images.mjs",
    "seed:board": "node scripts/seed-board.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@gitbeaker/rest": "^43.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "lucide-react": "1.70.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "10.1.0",
    "simple-git": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  }
}
